# Gmail Credentials
# To generate a Gmail App Password:
# 1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and the 16-character password below
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Automation Configuration
EMAIL_SUBJECT=Important: How to update your Netflix household
EMAIL_BUTTON_TEXT=Yes, this was me
CONFIRM_BUTTON_TEXT=Confirm Update

# Browser Settings
# Set to false if you want to visually watch the Chromium browser run
HEADLESS=true

# Operational Settings
MARK_AS_READ=true
POLL_INTERVAL=15
SCREENSHOTS_DIR=screenshots
LOGS_DIR=logs
PURGE_DAYS=7
